<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Forge.App.Views.ConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PreviewKeyDown="View_PreviewKeyDown">

    <!-- One config file: read it (an environment file's values masked), or edit it explicitly. -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ToggleButton Grid.Column="1" x:Name="RevealButton" Click="RevealButton_Click" Visibility="Collapsed"
                          ToolTipService.ToolTip="Show the values (they are hidden while reading)" AutomationProperties.Name="Reveal values">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE7B3;" />
                    <TextBlock Text="Reveal" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton Grid.Column="2" x:Name="WrapButton" Click="WrapButton_Click" ToolTipService.ToolTip="Wrap long lines"
                          AutomationProperties.Name="Wrap lines">
                <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE751;" />
            </ToggleButton>
            <Button Grid.Column="3" x:Name="ReloadButton" Click="ReloadButton_Click" ToolTipService.ToolTip="Read it from Forge again (F5)"
                    AutomationProperties.Name="Reload">
                <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button Grid.Column="4" x:Name="CopyButton" Click="CopyButton_Click" ToolTipService.ToolTip="Copy the whole file, as Forge holds it"
                    AutomationProperties.Name="Copy">
                <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE8C8;" />
            </Button>
            <Button Grid.Column="5" x:Name="EditButton" Click="EditButton_Click" MinWidth="88"
                    ToolTipService.ToolTip="Edit this file. Nothing is sent until you save and confirm." AutomationProperties.Name="Edit">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE70F;" />
                    <TextBlock Text="Edit" />
                </StackPanel>
            </Button>
            <Button Grid.Column="6" x:Name="DiscardButton" Click="DiscardButton_Click" Visibility="Collapsed" MinWidth="88"
                    ToolTipService.ToolTip="Drop your edit (Esc)" AutomationProperties.Name="Discard" Content="Discard" />
            <Button Grid.Column="7" x:Name="SaveButton" Click="SaveButton_Click" Visibility="Collapsed" MinWidth="88"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Shows what changes and asks first (Ctrl+S)" AutomationProperties.Name="Save" Content="Save…" />
        </Grid>

        <TextBlock Grid.Row="1" x:Name="HeaderText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                              VerticalScrollBarVisibility="Auto" IsTabStop="True">
                    <TextBlock x:Name="ReadText" FontFamily="{StaticResource MonoFont}" FontSize="12.5" LineHeight="20"
                               IsTextSelectionEnabled="True" TextWrapping="NoWrap" Padding="14,10,16,14" />
                </ScrollViewer>
                <TextBox x:Name="Editor" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="{StaticResource MonoFont}" FontSize="12.5" Padding="14,10,16,14"
                         IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         TextChanged="Editor_TextChanged" AutomationProperties.Name="File contents" />
                <ProgressRing x:Name="LoadingRing" IsActive="False" Width="28" Height="28" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
