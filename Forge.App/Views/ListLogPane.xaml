<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Forge.App.Views.ListLogPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Forge.App.Views">

    <!-- A list beside what the chosen row printed, as server events sit beside their output. -->
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="4">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView x:Name="Items" SelectionMode="Single" SelectionChanged="Items_SelectionChanged" />
                <Button Grid.Row="1" x:Name="MoreButton" Content="Load more" Visibility="Collapsed" HorizontalAlignment="Stretch"
                        Click="MoreButton_Click" Margin="4" />
            </Grid>
        </Border>
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="ActionBar" Visibility="Collapsed" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ActionText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="1" x:Name="ActionButton" MinWidth="96" Click="ActionButton_Click" />
            </Grid>
            <local:LogView Grid.Row="1" x:Name="Log" x:FieldModifier="public" Compact="True" />
        </Grid>
    </Grid>
</UserControl>
