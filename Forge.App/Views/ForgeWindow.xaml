<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Forge.App.Views.ForgeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Forge.App.Views"
    Title="Forge for Windows">

    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="FocusSearch_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="Reload_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Reload_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <DataTemplate x:Key="EntryTemplate" x:DataType="local:ListEntry">
                <Grid MinHeight="{x:Bind Height}" Padding="{x:Bind Indent}" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" StrokeThickness="2" VerticalAlignment="Center"
                             Fill="{x:Bind DotFill}" Stroke="{x:Bind DotStroke}" Visibility="{x:Bind DotVisibility}" />
                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="12" Glyph="&#xE977;" Visibility="{x:Bind GlyphVisibility}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" FontWeight="{x:Bind TitleWeight}" FontSize="{x:Bind TitleSize}"
                                   Foreground="{x:Bind TitleBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisibility}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind Status}" Foreground="{x:Bind StatusBrush}" FontWeight="{x:Bind StatusWeight}"
                                   HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Time}" Visibility="{x:Bind TimeVisibility}" HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <Style x:Key="EntryContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the app, and a search that is always one click (or Ctrl+F) away. -->
        <Grid x:Name="TitleBarArea" ColumnSpacing="12" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionInset" Width="138" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="AppTitle" Text="Forge for Windows" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            <AutoSuggestBox Grid.Column="2" x:Name="SearchBox" PlaceholderText="Search servers and sites" QueryIcon="Find"
                            Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted"
                            KeyDown="SearchBox_KeyDown" AutomationProperties.Name="Search servers and sites"
                            ToolTipService.ToolTip="Search (Ctrl+F)" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation: organizations, then every server with its sites. -->
            <Grid Padding="8,0,8,8" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="OrgScroll" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" IsTabStop="False">
                    <SelectorBar x:Name="OrgBar" SelectionChanged="OrgBar_SelectionChanged" />
                </ScrollViewer>
                <ListView Grid.Row="2" x:Name="NavList" SelectionMode="Single" ItemTemplate="{StaticResource EntryTemplate}"
                          ItemContainerStyle="{StaticResource EntryContainer}" SelectionChanged="NavList_SelectionChanged"
                          AutomationProperties.Name="Servers and sites" />
                <Grid Grid.Row="3" ColumnSpacing="4" Padding="8,6,0,0" BorderThickness="0,1,0,0"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UpdatedText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Click="Refresh_Click" Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                            ToolTipService.ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh">
                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <Button Grid.Column="2" Click="Settings_Click" Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                            ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE713;" />
                    </Button>
                </Grid>
            </Grid>

            <!-- Content: the chosen site or server. -->
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <Grid>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360">
                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="32" Glyph="&#xE977;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="EmptyTitle" Text="Pick a site or a server" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="EmptyText" Text="Its logs, actions and details open here." HorizontalAlignment="Center"
                                   TextAlignment="Center" Style="{StaticResource Caption}" />
                    </StackPanel>

                    <!-- A site -->
                    <Grid x:Name="SitePage" Visibility="Collapsed" Padding="28,20,28,20" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SiteCrumb" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="SiteTitle" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <Ellipse x:Name="SiteDot" Width="10" Height="10" StrokeThickness="2" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SiteStatus" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SiteStatusDetail" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="DeployButton" Style="{StaticResource AccentButtonStyle}" Click="Deploy_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE898;" />
                                        <TextBlock x:Name="DeployText" Text="Deploy" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OpenSiteButton" Click="OpenSite_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE8A7;" />
                                        <TextBlock Text="Open site" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OpenForge_Click" Content="Open in Forge" />
                                <Button AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions" Padding="8,5">
                                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Text="Copy ssh command" Click="CopySsh_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Open ssh in Windows Terminal" Click="Terminal_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Go to its server" Click="GoToServer_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE977;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <InfoBar Grid.Row="1" x:Name="SiteInfo" IsOpen="False" IsClosable="False">
                            <InfoBar.ActionButton>
                                <HyperlinkButton x:Name="SiteInfoLink" Content="View log" Click="SiteInfoLink_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <SelectorBar Grid.Row="2" x:Name="SiteTabs" SelectionChanged="SiteTabs_SelectionChanged">
                            <SelectorBarItem Text="Overview" Tag="overview" />
                            <SelectorBarItem Text="Deployments" Tag="deployments" />
                            <SelectorBarItem Text="Logs" Tag="logs" />
                            <SelectorBarItem Text="Schedule" Tag="schedule" />
                            <SelectorBarItem Text="Config" Tag="config" />
                            <SelectorBarItem Text="Deploy" Tag="deploy" />
                            <SelectorBarItem Text="SSL" Tag="ssl" />
                            <SelectorBarItem Text="Heartbeats" Tag="heartbeats" />
                            <SelectorBarItem Text="Run a command" Tag="command" />
                        </SelectorBar>

                        <Grid Grid.Row="3">
                            <ScrollViewer x:Name="OverviewPanel">
                                <Grid ColumnSpacing="16" Padding="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="340" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Details" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <Grid x:Name="FactsGrid" ColumnSpacing="24" RowSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="12">
                                        <Border Style="{StaticResource Card}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Maintenance mode" />
                                                    <TextBlock x:Name="MaintenanceText" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" x:Name="MaintenanceSwitch" MinWidth="0" Toggled="MaintenanceSwitch_Toggled"
                                                              OnContent="On" OffContent="Off"
                                                              AutomationProperties.Name="Maintenance mode" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Tools" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <Button x:Name="PhpReloadButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="PhpReload_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE72C;" />
                                                        <TextBlock x:Name="PhpReloadText" Text="Reload PHP-FPM" />
                                                    </StackPanel>
                                                </Button>
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="RunCommandTab_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE756;" />
                                                        <TextBlock Text="Run a command" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Connect" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="CopySsh_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE8C8;" />
                                                        <TextBlock Text="Copy ssh command" />
                                                    </StackPanel>
                                                </Button>
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Terminal_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE756;" />
                                                        <TextBlock Text="Open ssh in Windows Terminal" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <!-- Every list-and-output section is a ListLogPane: list on the left, the chosen item's output beside it. -->
                            <local:ListLogPane x:Name="SiteDeployments" Visibility="Collapsed" ListName="Deployments" FollowFirst="True"
                                               ItemTemplate="{StaticResource EntryTemplate}" ItemContainerStyle="{StaticResource EntryContainer}" />
                            <local:ListLogPane x:Name="SiteLogs" Visibility="Collapsed" ListName="Site logs"
                                               ItemTemplate="{StaticResource EntryTemplate}" ItemContainerStyle="{StaticResource EntryContainer}" />
                            <local:ListLogPane x:Name="SiteJobs" Visibility="Collapsed" ListName="Scheduled jobs"
                                               ItemTemplate="{StaticResource EntryTemplate}" ItemContainerStyle="{StaticResource EntryContainer}" />
                            <!-- The environment file, deploy script and nginx config: read, or edit and save with a diff. -->
                            <local:ConfigPane x:Name="SiteConfig" Visibility="Collapsed"
                                              ItemTemplate="{StaticResource EntryTemplate}" ItemContainerStyle="{StaticResource EntryContainer}" />

                            <!-- How the site deploys: quick deploy, the deploy hook, webhooks and the deploy key. Read when the tab opens. -->
                            <ScrollViewer x:Name="DeployPanel" Visibility="Collapsed">
                                <StackPanel Spacing="12" Padding="0,0,0,8" MaxWidth="760" HorizontalAlignment="Left">
                                    <Border Style="{StaticResource Card}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Quick deploy" />
                                                <TextBlock x:Name="QuickDeployText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" x:Name="QuickDeploySwitch" MinWidth="0" Toggled="QuickDeploySwitch_Toggled"
                                                          OnContent="On" OffContent="Off"
                                                          AutomationProperties.Name="Quick deploy" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Deploy hook" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                       Text="A URL that deploys the site when called, for CI. Anyone holding it can deploy, so it is copied without being shown and kept out of clipboard history." />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="DeployHookCopyButton" Click="DeployHookCopy_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE8C8;" />
                                                        <TextBlock Text="Copy URL" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="DeployHookRegenerateButton" Click="DeployHookRegenerate_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE72C;" />
                                                        <TextBlock Text="Regenerate…" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Deployment webhooks" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="WebhooksText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <StackPanel x:Name="WebhookRows" Spacing="4" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="WebhookBox" PlaceholderText="https://example.com/forge-deployed" IsSpellCheckEnabled="False"
                                                         KeyDown="WebhookBox_KeyDown" TextChanged="WebhookBox_TextChanged"
                                                         AutomationProperties.Name="Webhook URL" />
                                                <Button Grid.Column="1" x:Name="WebhookAddButton" Content="Add…" Click="WebhookAdd_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Deploy key" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="DeployKeyState" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="DeployKeyText" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True" MaxLines="4" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="DeployKeyCopyButton" Content="Copy public key" Click="DeployKeyCopy_Click" Visibility="Collapsed" />
                                                <Button x:Name="DeployKeyCreateButton" Content="Create…" Click="DeployKeyCreate_Click" Visibility="Collapsed" />
                                                <Button x:Name="DeployKeyDeleteButton" Content="Delete…" Click="DeployKeyDelete_Click" Visibility="Collapsed" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- The site's domains and each one's active certificate. Read when the tab opens: one request per domain. -->
                            <ScrollViewer x:Name="SslPanel" Visibility="Collapsed">
                                <StackPanel Spacing="12" Padding="0,0,0,8" MaxWidth="760" HorizontalAlignment="Left">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Certificates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="CertificatesText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <StackPanel x:Name="CertificateRows" Spacing="6" />
                                            <Button x:Name="CertificatesMoreButton" Click="CertificatesMore_Click" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid x:Name="HeartbeatsPanel" Visibility="Collapsed" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="HeartbeatsText" Style="{StaticResource Caption}" />
                                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                                    <ListView x:Name="HeartbeatList" SelectionMode="None" ItemTemplate="{StaticResource EntryTemplate}"
                                              ItemContainerStyle="{StaticResource EntryContainer}" />
                                </Border>
                            </Grid>

                            <Grid x:Name="CommandPanel" Visibility="Collapsed" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CommandBox" FontFamily="{StaticResource MonoFont}" PlaceholderText="php artisan about"
                                             IsSpellCheckEnabled="False" KeyDown="CommandBox_KeyDown" TextChanged="CommandBox_TextChanged"
                                             AutomationProperties.Name="Command" />
                                    <Button Grid.Column="1" x:Name="RunButton" Content="Run" Style="{StaticResource AccentButtonStyle}" Click="Run_Click" />
                                </Grid>
                                <TextBlock Grid.Row="1" x:Name="CommandState" Style="{StaticResource Caption}"
                                           Text="Runs as the site's user, in the site's directory. Run asks before it sends." />
                                <local:LogView Grid.Row="2" x:Name="CommandOutput" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- A server -->
                    <Grid x:Name="ServerPage" Visibility="Collapsed" Padding="28,20,28,20" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ServerCrumb" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="ServerTitle" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <Ellipse x:Name="ServerDot" Width="10" Height="10" StrokeThickness="2" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ServerStatus" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OpenForge_Click" Content="Open in Forge" />
                                <Button Click="CopySsh_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE8C8;" />
                                        <TextBlock Text="Copy ssh" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Terminal_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE756;" />
                                        <TextBlock Text="Open in Terminal" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <SelectorBar Grid.Row="1" x:Name="ServerTabs" SelectionChanged="ServerTabs_SelectionChanged">
                            <SelectorBarItem Text="Services" Tag="services" />
                            <SelectorBarItem Text="Events" Tag="events" />
                            <SelectorBarItem Text="Logs" Tag="logs" />
                            <SelectorBarItem Text="Processes" Tag="processes" />
                            <SelectorBarItem Text="Schedule" Tag="schedule" />
                            <SelectorBarItem Text="SSH keys" Tag="ssh-keys" />
                            <SelectorBarItem Text="Firewall" Tag="firewall" />
                        </SelectorBar>
                        <Grid Grid.Row="2">
                            <ScrollViewer x:Name="ServicesPanel">
                                <StackPanel x:Name="ServiceCards" Spacing="4" Padding="0,0,0,8" MaxWidth="900" HorizontalAlignment="Left" Width="720" />
                            </ScrollViewer>
                            <local:ListLogPane x:Name="ServerEvents" Visibility="Collapsed" ListName="Server events" FollowFirst="True"
                                               ItemTemplate="{StaticResource EntryTemplate}" ItemContainerStyle="{StaticResource EntryContainer}" />
                            <local:ListLogPane x:Name="ServerLogs" Visibility="Collapsed" ListName="Server logs"
                                               ItemTemplate="{StaticResource EntryTemplate}" ItemContainerStyle="{StaticResource EntryContainer}" />
                            <local:ListLogPane x:Name="ServerProcesses" Visibility="Collapsed" ListName="Background processes"
                                               ItemTemplate="{StaticResource EntryTemplate}" ItemContainerStyle="{StaticResource EntryContainer}" />
                            <local:ListLogPane x:Name="ServerJobs" Visibility="Collapsed" ListName="Scheduled jobs"
                                               ItemTemplate="{StaticResource EntryTemplate}" ItemContainerStyle="{StaticResource EntryContainer}" />

                            <!-- Who may sign in: the keys on the server, adding this machine's key, and the server's own key. -->
                            <ScrollViewer x:Name="SshKeysPanel" Visibility="Collapsed">
                                <StackPanel Spacing="12" Padding="0,0,0,8" MaxWidth="760" HorizontalAlignment="Left">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Keys that can sign in" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="SshKeysText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <StackPanel x:Name="SshKeyRows" Spacing="4" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Add my key" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="LocalKeysText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                       Text="Pick a public key from your .ssh folder, choose a .pub file elsewhere, or paste one. Only .pub files are read: a private key never leaves this machine." />
                                            <ComboBox x:Name="LocalKeyBox" HorizontalAlignment="Stretch" SelectionChanged="LocalKeyBox_SelectionChanged"
                                                      AutomationProperties.Name="Public key" />
                                            <TextBox x:Name="PasteKeyBox" Visibility="Collapsed" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                     PlaceholderText="ssh-ed25519 AAAA... you@machine" IsSpellCheckEnabled="False" TextWrapping="Wrap"
                                                     TextChanged="AccessInput_Changed" AutomationProperties.Name="Paste a public key" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="KeyNameBox" Header="Name" IsSpellCheckEnabled="False" TextChanged="AccessInput_Changed" />
                                                <TextBox Grid.Column="1" x:Name="KeyUserBox" Header="Server user" Text="forge" IsSpellCheckEnabled="False"
                                                         TextChanged="AccessInput_Changed" />
                                                <Button Grid.Column="2" x:Name="AddKeyButton" Content="Add…" VerticalAlignment="Bottom" Click="AddKey_Click" />
                                            </Grid>
                                            <TextBlock x:Name="AddKeyText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <Button x:Name="AddedKeyTerminalButton" Visibility="Collapsed" Click="Terminal_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE756;" />
                                                    <TextBlock Text="Open ssh in Windows Terminal" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Server key" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="ServerKeyState" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="ServerKeyText" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True" MaxLines="4" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                            <Button x:Name="ServerKeyCopyButton" Content="Copy public key" Click="ServerKeyCopy_Click" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- The firewall's rules, and adding one. -->
                            <ScrollViewer x:Name="FirewallPanel" Visibility="Collapsed">
                                <StackPanel Spacing="12" Padding="0,0,0,8" MaxWidth="760" HorizontalAlignment="Left">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Rules" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="FirewallText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <StackPanel x:Name="FirewallRows" Spacing="4" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Add a rule" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="RuleNameBox" Header="Name" PlaceholderText="Office" IsSpellCheckEnabled="False"
                                                         TextChanged="AccessInput_Changed" />
                                                <TextBox Grid.Column="1" x:Name="RulePortBox" Header="Port" PlaceholderText="22 or 8000:8010"
                                                         IsSpellCheckEnabled="False" TextChanged="AccessInput_Changed" />
                                                <ComboBox Grid.Column="2" x:Name="RuleTypeBox" Header="Type" SelectedIndex="0" MinWidth="110"
                                                          SelectionChanged="RuleType_Changed">
                                                    <ComboBoxItem Content="Allow" Tag="allow" />
                                                    <ComboBoxItem Content="Deny" Tag="deny" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="RuleIpBox" Header="From" PlaceholderText="Any address, or 203.0.113.7, 198.51.100.0/24"
                                                         IsSpellCheckEnabled="False" TextChanged="AccessInput_Changed" />
                                                <Button Grid.Column="1" x:Name="LookUpIpButton" VerticalAlignment="Bottom" Click="LookUpIp_Click"
                                                        Content="Look up my IP (api.ipify.org)"
                                                        ToolTipService.ToolTip="Asks api.ipify.org for this machine's public address. Nothing is sent until you press it." />
                                                <Button Grid.Column="2" x:Name="AddRuleButton" Content="Add…" VerticalAlignment="Bottom" Click="AddRule_Click" />
                                            </Grid>
                                            <TextBlock x:Name="AddRuleText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- What just happened. -->
                    <InfoBar x:Name="FlashBar" IsOpen="False" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,20" MaxWidth="520" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
